# Optional. API keys are normally added in the app (Library → "Gemini API keys…"),
# which stores them in Windows Credential Manager. Use this file only if you prefer
# environment variables. Copy to .env (git-ignored) and never commit real keys.

# GEMINI_API_KEY=
# GEMINI_PROJECT=default
# GEMINI_API_KEY_1=
# GEMINI_PROJECT_1=project-a

# Requests per minute per project (set to your quota)
GEMINI_RPM=15
GEMINI_CONCURRENCY=3
GEMINI_TIMEOUT_S=180
GEMINI_MAX_ATTEMPTS=4
GEMINI_TEMPERATURE=0.4

# Per-model limits as model=rpm/rpd (built in: gemini-3.5-flash-lite=15/500, gemini-3.8-flash=15/20)
# GEMINI_MODEL_LIMITS=gemini-3.5-flash-lite=15/500

# Rough number of questions Gemini aims for per page (never enforced)
# QUESTIONS_PER_PAGE=5
